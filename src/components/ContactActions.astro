---
/**
 * メール作成ボタン・アドレスのコピー・担当者表記。
 * お問い合わせページと支援ページで同じものを使う（1ページに1つまで）。
 */
import { CONTACT_EMAIL, CONTACT_MAILTO, OPERATOR } from "../utils/site-info";

interface Props {
	/** 担当者表記を出すか（担当者を別に大きく出すページでは false） */
	showPerson?: boolean;
}
const { showPerson = true } = Astro.props;
---

<div class="contact-actions">
	<a class="btn contact-actions__primary" href={CONTACT_MAILTO}>メールを作成する</a>

	<p class="contact-actions__label">送り先のメールアドレス</p>
	<div class="contact-actions__address">
		<span class="contact-actions__email" id="contact-email">{CONTACT_EMAIL}</span>
		<button
			type="button"
			class="btn btn--ghost contact-actions__copy"
			data-copy={CONTACT_EMAIL}
			aria-describedby="copy-status"
		>
			メールアドレスをコピー
		</button>
	</div>
	<p class="contact-actions__status" id="copy-status" role="status" aria-live="polite"></p>

	<p class="contact-actions__note">
		ボタンを押すと、お使いのメールアプリなどの作成画面が開きます。この操作だけではメールは送信されません。開かない場合は、アドレスをコピーして普段お使いのメールからお送りください。
	</p>
	{showPerson && <p class="contact-actions__note">担当：{OPERATOR.display}</p>}
</div>

<script>
	const status = document.getElementById("copy-status");
	const emailEl = document.getElementById("contact-email");

	function selectAddress() {
		if (!emailEl) return;
		const range = document.createRange();
		range.selectNodeContents(emailEl);
		const sel = window.getSelection();
		sel?.removeAllRanges();
		sel?.addRange(range);
	}

	document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
		button.addEventListener("click", async () => {
			const text = button.dataset.copy ?? "";
			try {
				await navigator.clipboard.writeText(text);
				if (status) status.textContent = "コピーしました";
			} catch {
				// Clipboard can be blocked (permissions, non-secure context).
				// Leave the address selected so it can be copied by hand.
				selectAddress();
				if (status)
					status.textContent =
						"自動でコピーできませんでした。選択されたアドレスを長押し、または右クリックしてコピーしてください。";
			}
		});
	});
</script>

<style>
	.contact-actions {
		display: grid;
		gap: 0.75rem;
	}
	.contact-actions__primary {
		justify-self: start;
		min-height: 3rem;
		padding-inline: 1.75rem;
		font-size: 1.0625rem;
	}
	.contact-actions__label {
		margin-top: 0.75rem;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.contact-actions__address {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.contact-actions__email {
		font-size: 1.125rem;
		font-weight: 600;
		user-select: all;
		overflow-wrap: anywhere;
	}
	.contact-actions__copy {
		min-height: 2.75rem;
	}
	.contact-actions__status {
		min-height: 1.5em;
		color: var(--color-brand);
		font-weight: 600;
	}
	.contact-actions__note {
		line-height: 1.8;
		color: var(--color-text-secondary);
	}
</style>
