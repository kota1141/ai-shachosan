---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import SpeechBubble from "../components/blocks/SpeechBubble.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { learning_order: "asc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Get remaining posts (exclude featured if found, limit to 6 for grid)
const gridPosts = visiblePosts
	.filter((_, i) => i !== featuredIndex)
	.slice(0, 6);

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagEntryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title={siteTitle} description={siteTagline}>
	<header class="band intro">
		<div class="frame home-intro">
			<p class="eyebrow">薬局の経営者・担当者のためのMEO入門</p>
			<h1 class="intro__title home-intro__title">薬局のMEOを、<br />やさしく学ぶ。</h1>
			{siteTagline && <p class="intro__lead home-intro__lead">{siteTagline}</p>}
			<p class="home-intro__actions">
				<a class="btn home-intro__primary" href="/posts/what-is-meo">MEOの基本から読む</a>
				<a class="home-intro__secondary" href="/posts">記事の一覧を見る →</a>
			</p>
		</div>
	</header>
  <section class="band section" aria-label="ふたりと一緒に学ぶ">
    <div class="frame home-characters">
      <SpeechBubble speaker="question" expression="question" text="MEOが大事とは聞くけど、うちの薬局では何から始めればいい？" />
      <SpeechBubble speaker="answer" expression="explain" text="まずは、初めて来る方が何を知りたいか。一緒に、自分の薬局でできることを見つけましょう。" />
      <p class="home-characters__link"><a href="/characters/">三浦けんじと青葉まことをご紹介します<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>
  <section class="band section" aria-labelledby="learning-path">
    <div class="frame">
      <h2 id="learning-path" class="home-path__title">「MEOって何？」から、自分の薬局でできることまで。</h2>
      <p class="home-path__lead">この順番で読むと、仕組みから実際の作業、頼み方まで無理なくつながります。</p>
      <ol class="home-path">
        <li class="home-path__step">
          <span class="home-path__num">1</span>
          <h3>学ぶ</h3>
          <p>Googleマップで薬局が見つかる仕組みと、MEOで整えること。</p>
          <a href="/posts/what-is-meo">MEOとは？ →</a>
        </li>
        <li class="home-path__step">
          <span class="home-path__num">2</span>
          <h3>事例を知る</h3>
          <p>ほかの業界や海外の取り組みと、数字を読むときの注意点。</p>
          <a href="/posts/lessons-from-other-industries">ほかの業界に学ぶ →</a>
        </li>
        <li class="home-path__step">
          <span class="home-path__num">3</span>
          <h3>自分の薬局を確認する</h3>
          <p>営業時間、写真、相談の案内。最初に見る10項目。</p>
          <a href="/posts/first-checklist">10項目のチェック →</a>
        </li>
        <li class="home-path__step">
          <span class="home-path__num">4</span>
          <h3>続け方を選ぶ</h3>
          <p>自分で行う、最初の整備を頼む、毎月の保守を頼む。</p>
          <a href="/posts/outsourcing-maintenance">任せ方を比べる →</a>
        </li>
      </ol>
      <p class="home-path__note">事例は支援会社などの公表資料です。表示・クリックと、実際の来店や売上を分けて説明します。</p>
    </div>
  </section>

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">記事は下書きで準備されています</h2>
						<p class="empty-state__text">
							管理画面から初期記事を確認できます。公開前に内容・出典を確認してください。
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								管理画面を開く
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<>
				{featuredPost && (
					<section class="band section">
						<div class="frame">
							<PostCard
								post={featuredPost}
								tags={featuredTags}
								variant="feature"
								headingLevel={2}
								priority
							/>
						</div>
					</section>
				)}

				{gridPostsWithTags.length > 0 && (
					<section class="band section" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="latest-posts" class="section-head__title">
									まず読んでほしい記事
								</h2>
								{hasMorePosts && (
									<a href="/posts" class="arrow-link">
										すべて読む<span class="sr-only"> posts</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								)}
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		)
	}
	<section class="band section" aria-labelledby="home-contact">
		<div class="frame home-contact">
			<h2 id="home-contact">自分の薬局に当てはめて考えたいときは</h2>
			<p>何から始めればよいか、自分でできる範囲はどこまでか。相談内容がまとまっていなくても、メールでお気軽にどうぞ。</p>
			<a class="home-contact__link" href="/contact">メールで相談する →</a>
		</div>
	</section>
</Base>

<style>
	.home-characters { max-width: min(100%, 48rem); margin-inline: auto; }
	.home-characters__link { font-size: .9rem; text-align: right; line-height: 1.8; }
	.home-characters__link a { text-underline-offset: .2em; }

	.home-intro {
		max-width: 46rem;
	}

	.home-intro__title {
		font-size: clamp(2.25rem, 1.6rem + 3.2vw, 3.75rem);
		line-height: 1.2;
		margin-top: .5rem;
	}

	.home-intro__lead {
		font-size: clamp(1rem, .95rem + .3vw, 1.125rem);
		line-height: 1.9;
		margin-top: 1.25rem;
	}

	.home-intro__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}

	.home-intro__primary {
		min-height: 3rem;
		padding-inline: 1.75rem;
		font-size: 1.0625rem;
	}

	.home-intro__secondary {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	.home-path__title {
		font-size: clamp(1.375rem, 1.2rem + .8vw, 1.75rem);
		line-height: 1.5;
	}

	.home-path__lead {
		margin-top: .5rem;
		line-height: 1.85;
		color: var(--color-text-secondary);
	}

	.home-path {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1rem;
		margin-top: 1.75rem;
		list-style: none;
		padding: 0;
	}

	.home-path__step {
		position: relative;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		display: grid;
		gap: .4rem;
		align-content: start;
	}

	.home-path__step h3 {
		font-size: 1.0625rem;
	}

	.home-path__step p {
		line-height: 1.75;
		color: var(--color-text-secondary);
		font-size: .9375rem;
	}

	.home-path__step a {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		font-weight: 600;
		color: var(--color-brand);
	}

	.home-path__num {
		display: inline-grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 999px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: .875rem;
		font-weight: 700;
	}

	.home-path__note {
		margin-top: 1.25rem;
		font-size: var(--font-size-sm);
		line-height: 1.8;
		color: var(--color-muted);
	}

	.home-contact {
		max-width: 46rem;
	}

	.home-contact h2 {
		font-size: clamp(1.25rem, 1.1rem + .6vw, 1.5rem);
		line-height: 1.5;
	}

	.home-contact p {
		margin-top: .5rem;
		line-height: 1.85;
		color: var(--color-text-secondary);
	}

	.home-contact__link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		margin-top: .5rem;
		font-weight: 600;
		color: var(--color-brand);
	}
</style>
