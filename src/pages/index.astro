---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import SpeechBubble from "../components/blocks/SpeechBubble.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { learning_order: "asc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Get remaining posts (exclude featured if found, limit to 6 for grid)
const gridPosts = visiblePosts
	.filter((_, i) => i !== featuredIndex)
	.slice(0, 6);

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagEntryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title={siteTitle} description={siteTagline}>
	<header class="band intro">
		<div class="frame home-intro">
			<div>
				<p class="eyebrow">薬局の経営者・担当者のためのMEO入門</p>
				<h1 class="intro__title">薬局のMEOを、<br />やさしく学ぶ。</h1>
				{siteTagline && <p class="intro__lead">{siteTagline}</p>}
			</div>
			<a
				href="/rss.xml"
				type="application/rss+xml"
				class="btn btn--ghost btn--sm home-intro__rss"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
				更新情報
			</a>
		</div>
	</header>
  <section class="band section" aria-label="ふたりと一緒に学ぶ">
    <div class="frame home-characters">
      <SpeechBubble speaker="question" expression="question" text="MEOが大事とは聞くけど、うちの薬局では何から始めればいい？" />
      <SpeechBubble speaker="answer" expression="explain" text="まずは、初めて来る方が何を知りたいか。一緒に、自分の薬局でできることを見つけましょう。" />
      <p class="home-characters__link"><a href="/characters/">薬局長と青葉まことをご紹介します<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>
  <section class="band section"><div class="frame"><h2>「MEOって何？」から、自分の薬局でできることまで。</h2><p>MEOという言葉は聞いたけれど、何をするのかはまだ分からない。仕組み、期待できる変化、具体的な作業を、会話と事例で学べます。</p><p><a class="btn" href="/posts/what-is-meo">MEOの基本から読む</a> <a class="btn btn--ghost" href="/posts">学べるテーマを見る</a></p><p><a href="/posts/lessons-from-other-industries">ほかの業界の事例を読む</a> · <a href="/posts/regional-opportunity">地方の薬局の可能性を知る</a> · <a href="/services">初期整備・保守の内容を見る</a></p><p>このサイトは編集部初稿の構成確認用です。事例は支援会社の公表資料で、表示・クリックと実際の来店や売上を分けて説明します。</p></div></section>

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">記事は下書きで準備されています</h2>
						<p class="empty-state__text">
							管理画面から初期記事を確認できます。公開前に内容・出典を確認してください。
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								管理画面を開く
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<>
				{featuredPost && (
					<section class="band section">
						<div class="frame">
							<PostCard
								post={featuredPost}
								tags={featuredTags}
								variant="feature"
								headingLevel={2}
								priority
							/>
						</div>
					</section>
				)}

				{gridPostsWithTags.length > 0 && (
					<section class="band section" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="latest-posts" class="section-head__title">
									まず読んでほしい記事
								</h2>
								{hasMorePosts && (
									<a href="/posts" class="arrow-link">
										すべて読む<span class="sr-only"> posts</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								)}
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		)
	}
</Base>

<style>
	.home-characters { max-width: min(100%, 48rem); margin-inline: auto; }
	.home-characters__link { font-size: .9rem; text-align: right; line-height: 1.8; }
	.home-characters__link a { text-underline-offset: .2em; }

	.home-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--spacing-6) var(--spacing-8);
	}

	/* Lifts the pill from the line box's bottom onto the last line's baseline */
	.home-intro__rss {
		margin-block-end: var(--spacing-2);
	}

	@media (max-width: 720px) {
		.home-intro {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-intro__rss {
			justify-self: start;
			margin-block-end: 0;
		}
	}
</style>
